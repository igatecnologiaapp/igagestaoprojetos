# Copie para .env (nunca versionado) e preencha com os dados do projeto Supabase.
# Painel do Supabase → Project Settings → API.

# --- Públicas (vão para o navegador por design; a segurança é a RLS do banco) ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="chave-publica-anon-ou-publishable"
VITE_SUPABASE_PROJECT_ID="ref-do-projeto"

# Mesmos valores, lidos pelo servidor (SSR e funções de servidor).
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="chave-publica-anon-ou-publishable"
SUPABASE_PROJECT_ID="ref-do-projeto"

# --- SECRETA: somente no servidor (variável de ambiente da hospedagem, nunca VITE_*) ---
# Usada pelas funções de administração de usuários (convite, criação, redefinição de senha).
# Em desenvolvimento local, coloque no .env; na hospedagem, cadastre como variável secreta.
SUPABASE_SERVICE_ROLE_KEY=""

# Opcional: força o destino do build (padrão: detecção automática; fora de plataformas conhecidas, Node).
# NITRO_PRESET="vercel"
